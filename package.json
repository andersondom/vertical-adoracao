{
  "name": "ministerio-louvor-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply louvor-db --local",
    "db:remote": "wrangler d1 migrations apply louvor-db --remote",
    "test": "node --test",
    "seed:local": "wrangler d1 execute louvor-db --local --file scripts/seed-local.sql"
  },
  "devDependencies": {
    "wrangler": "^4.33.1"
  }
}
